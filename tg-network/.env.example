# Скопируй в .env и заполни. Файл .env не коммитится.

# --- Telegram
BOT_TOKEN=123456789:AA...                 # от @BotFather
OWNER_CHAT_ID=                            # твой id: python -m tgnet whoami

FOOTBALL_CHAT_ID=@your_football_channel   # или -100xxxxxxxxxx
FOOTBALL_USERNAME=your_football_channel
FOOTBALL_DISCUSSION_ID=                   # -100… группы комментариев (необязательно)

ESPORTS_CHAT_ID=@your_esports_channel
ESPORTS_USERNAME=your_esports_channel
ESPORTS_DISCUSSION_ID=

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Точные id моделей возьми из AI Studio (как они пишутся в API). Проверка: python -m tgnet check
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_SMART_MODEL=gemini-4-argon
# Цены в $ за 1M токенов – нужны только для контроля дневного бюджета
GEMINI_FAST_PRICE_IN=0.3
GEMINI_FAST_PRICE_OUT=2.5
GEMINI_SMART_PRICE_IN=1.25
GEMINI_SMART_PRICE_OUT=10

# --- Второй провайдер: любой OpenAI-совместимый API (ключ sk-…)
EASY_BASE_URL=https://api.example.com/v1
EASY_API_KEY=sk-...
EASY_MODEL=gpt-4o-mini

# --- Локальная модель на ноутбуке (Ollama), доступ с VPS через Tailscale
OLLAMA_BASE_URL=http://100.x.y.z:11434/v1
OLLAMA_MODEL=qwen3:14b
